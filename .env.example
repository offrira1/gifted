# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Single admin: משתמש וסיסמה לכניסה למנהל (ברירת מחדל: admin / admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# חתימת cookie של המנהל (לשנות בפרודקשן)
GIFTED_ADMIN_SECRET=change-this-in-production

# חובה למנהל יחיד: Service Role Key מ-Supabase (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Base URL for QR and links (defaults to https://gifted.example.com if unset)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
